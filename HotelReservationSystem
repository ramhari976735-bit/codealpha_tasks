import java.io.*;
import java.time.LocalDate;
import java.time.temporal.ChronoUnit;
import java.util.*;

/**
 * CodeAlpha Task 4: Hotel Reservation System
 * Console-based demonstration. Payments are simulated; no real money is charged.
 */
public class HotelReservationSystem {
    private static final String FILE_NAME = "bookings.csv";
    private static final Scanner SC = new Scanner(System.in);
    private static final List<Room> rooms = new ArrayList<Room>();
    private static final List<Booking> bookings = new ArrayList<Booking>();
    private static int nextBookingId = 1001;

    enum RoomType {
        STANDARD(1500), DELUXE(2500), SUITE(4000);
        final double rate;
        RoomType(double rate) { this.rate = rate; }
    }

    static class Room {
        int number;
        RoomType type;
        Room(int number, RoomType type) { this.number = number; this.type = type; }
    }

    static class Booking {
        int bookingId;
        String guestName;
        String phone;
        int roomNumber;
        LocalDate checkIn;
        LocalDate checkOut;
        double amountPaid;
        String status;

        Booking(int bookingId, String guestName, String phone, int roomNumber,
                LocalDate checkIn, LocalDate checkOut, double amountPaid, String status) {
            this.bookingId = bookingId;
            this.guestName = guestName;
            this.phone = phone;
            this.roomNumber = roomNumber;
            this.checkIn = checkIn;
            this.checkOut = checkOut;
            this.amountPaid = amountPaid;
            this.status = status;
        }
    }

    public static void main(String[] args) {
        initializeRooms();
        loadBookings();
        while (true) {
            System.out.println("\n========== HOTEL RESERVATION SYSTEM ==========");
            System.out.println("1. View room categories and rates");
            System.out.println("2. Search available rooms");
            System.out.println("3. Book a room");
            System.out.println("4. View booking details");
            System.out.println("5. Cancel reservation");
            System.out.println("6. View all reservations");
            System.out.println("7. Save and exit");
            int choice = readInt("Choose an option: ", 1, 7);
            switch (choice) {
                case 1: showRoomTypes(); break;
                case 2: searchRooms(); break;
                case 3: bookRoom(); break;
                case 4: viewBooking(); break;
                case 5: cancelBooking(); break;
                case 6: showAllBookings(); break;
                case 7:
                    saveBookings();
                    System.out.println("Bookings saved. Goodbye!");
                    return;
                default: break;
            }
        }
    }

    private static void initializeRooms() {
        for (int i = 101; i <= 105; i++) rooms.add(new Room(i, RoomType.STANDARD));
        for (int i = 201; i <= 204; i++) rooms.add(new Room(i, RoomType.DELUXE));
        for (int i = 301; i <= 302; i++) rooms.add(new Room(i, RoomType.SUITE));
    }

    private static void showRoomTypes() {
        System.out.println("\nRoom Categories (rates per night)");
        for (RoomType type : RoomType.values()) {
            System.out.printf("%-10s : Rs. %.2f per night%n", type, type.rate);
        }
        System.out.println("Rooms available in inventory: Standard 101-105, Deluxe 201-204, Suite 301-302.");
    }

    private static void searchRooms() {
        LocalDate in = readDate("Check-in date (YYYY-MM-DD): ");
        LocalDate out = readDate("Check-out date (YYYY-MM-DD): ");
        if (!validDates(in, out)) return;
        boolean found = false;
        System.out.println("\nAvailable rooms:");
        for (Room room : rooms) {
            if (isAvailable(room.number, in, out)) {
                System.out.printf("Room %d | %s | Rs. %.2f/night%n",
                        room.number, room.type, room.type.rate);
                found = true;
            }
        }
        if (!found) System.out.println("No rooms are available for those dates.");
    }

    private static void bookRoom() {
        String name = readNonEmpty("Guest full name: ");
        String phone = readNonEmpty("Contact number: ");
        LocalDate in = readDate("Check-in date (YYYY-MM-DD): ");
        LocalDate out = readDate("Check-out date (YYYY-MM-DD): ");
        if (!validDates(in, out)) return;

        List<Room> available = new ArrayList<Room>();
        for (Room room : rooms) if (isAvailable(room.number, in, out)) available.add(room);
        if (available.isEmpty()) {
            System.out.println("Sorry, no rooms are available for these dates.");
            return;
        }

        System.out.println("Available rooms:");
        for (Room room : available) {
            System.out.printf("Room %d | %s | Rs. %.2f/night%n",
                    room.number, room.type, room.type.rate);
        }
        int roomNo = readInt("Enter room number to book: ", 101, 302);
        Room selected = null;
        for (Room room : available) if (room.number == roomNo) selected = room;
        if (selected == null) {
            System.out.println("That room is not in the available list.");
            return;
        }

        long nights = ChronoUnit.DAYS.between(in, out);
        double total = nights * selected.type.rate;
        System.out.printf("Stay: %d night(s); total amount: Rs. %.2f%n", nights, total);
        System.out.println("Payment simulation: 1. Pay by UPI  2. Pay by Card  3. Cancel");
        int paymentChoice = readInt("Choose payment option: ", 1, 3);
        if (paymentChoice == 3) {
            System.out.println("Booking cancelled before confirmation.");
            return;
        }
        System.out.println("SIMULATED PAYMENT: Rs. " + String.format("%.2f", total)
                + " marked as paid. No real payment was processed.");

        Booking booking = new Booking(nextBookingId++, name, phone, roomNo, in, out, total, "CONFIRMED");
        bookings.add(booking);
        saveBookings();
        printBooking(booking);
    }

    private static void viewBooking() {
        int id = readInt("Enter booking ID: ", 1, Integer.MAX_VALUE);
        Booking booking = findBooking(id);
        if (booking == null) System.out.println("Booking not found.");
        else printBooking(booking);
    }

    private static void cancelBooking() {
        int id = readInt("Enter booking ID to cancel: ", 1, Integer.MAX_VALUE);
        Booking booking = findBooking(id);
        if (booking == null) {
            System.out.println("Booking not found.");
            return;
        }
        if (!"CONFIRMED".equals(booking.status)) {
            System.out.println("This booking is already cancelled.");
            return;
        }
        booking.status = "CANCELLED";
        saveBookings();
        System.out.println("Reservation " + id + " cancelled. Refund is not processed in this demo.");
    }

    private static void showAllBookings() {
        if (bookings.isEmpty()) {
            System.out.println("No reservations found.");
            return;
        }
        for (Booking b : bookings) printBooking(b);
    }

    private static void printBooking(Booking b) {
        Room room = getRoom(b.roomNumber);
        System.out.println("\n-------------- BOOKING DETAILS --------------");
        System.out.println("Booking ID : " + b.bookingId);
        System.out.println("Guest      : " + b.guestName);
        System.out.println("Phone      : " + b.phone);
        System.out.println("Room       : " + b.roomNumber + (room == null ? "" : " (" + room.type + ")"));
        System.out.println("Check-in   : " + b.checkIn);
        System.out.println("Check-out  : " + b.checkOut);
        System.out.printf("Amount     : Rs. %.2f%n", b.amountPaid);
        System.out.println("Status     : " + b.status);
        System.out.println("---------------------------------------------");
    }

    private static boolean isAvailable(int roomNumber, LocalDate in, LocalDate out) {
        for (Booking b : bookings) {
            if (b.roomNumber == roomNumber && "CONFIRMED".equals(b.status)) {
                // A room is occupied if date ranges overlap.
                if (in.isBefore(b.checkOut) && out.isAfter(b.checkIn)) return false;
            }
        }
        return true;
    }

    private static boolean validDates(LocalDate in, LocalDate out) {
        if (!out.isAfter(in)) {
            System.out.println("Check-out must be after check-in.");
            return false;
        }
        if (in.isBefore(LocalDate.now())) {
            System.out.println("Check-in cannot be in the past.");
            return false;
        }
        return true;
    }

    private static Room getRoom(int number) {
        for (Room room : rooms) if (room.number == number) return room;
        return null;
    }

    private static Booking findBooking(int id) {
        for (Booking b : bookings) if (b.bookingId == id) return b;
        return null;
    }

    private static void loadBookings() {
        File file = new File(FILE_NAME);
        if (!file.exists()) return;
        try (BufferedReader br = new BufferedReader(new FileReader(file))) {
            String line;
            while ((line = br.readLine()) != null) {
                String[] p = line.split(",", -1);
                if (p.length != 9) continue;
                try {
                    Booking b = new Booking(Integer.parseInt(p[0]), p[1], p[2],
                            Integer.parseInt(p[3]), LocalDate.parse(p[4]), LocalDate.parse(p[5]),
                            Double.parseDouble(p[6]), p[7]);
                    // p[8] is reserved for future schema version; current files write "v1".
                    bookings.add(b);
                    if (b.bookingId >= nextBookingId) nextBookingId = b.bookingId + 1;
                } catch (RuntimeException ignored) {
                    System.out.println("Skipped one invalid booking record.");
                }
            }
        } catch (IOException e) {
            System.out.println("Could not load bookings: " + e.getMessage());
        }
    }

    private static void saveBookings() {
        try (PrintWriter out = new PrintWriter(new FileWriter(FILE_NAME))) {
            for (Booking b : bookings) {
                out.println(b.bookingId + "," + safe(b.guestName) + "," + safe(b.phone) + ","
                        + b.roomNumber + "," + b.checkIn + "," + b.checkOut + ","
                        + b.amountPaid + "," + b.status + ",v1");
            }
        } catch (IOException e) {
            System.out.println("Could not save bookings: " + e.getMessage());
        }
    }

    private static String safe(String value) {
        return value.replace(",", " ").replace("\n", " ").replace("\r", " ");
    }

    private static String readNonEmpty(String prompt) {
        while (true) {
            System.out.print(prompt);
            String value = SC.nextLine().trim();
            if (!value.isEmpty()) return value;
            System.out.println("Input cannot be empty.");
        }
    }

    private static int readInt(String prompt, int min, int max) {
        while (true) {
            System.out.print(prompt);
            try {
                int value = Integer.parseInt(SC.nextLine().trim());
                if (value >= min && value <= max) return value;
            } catch (NumberFormatException ignored) {}
            System.out.println("Enter a whole number from " + min + " to " + max + ".");
        }
    }

    private static LocalDate readDate(String prompt) {
        while (true) {
            System.out.print(prompt);
            try {
                return LocalDate.parse(SC.nextLine().trim());
            } catch (Exception e) {
                System.out.println("Use the format YYYY-MM-DD, for example 2026-12-25.");
            }
        }
    }
}
